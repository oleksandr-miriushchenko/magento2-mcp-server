# Model provider credentials. Fill only the provider used by the example you run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. Without these, each example uses its documented default.
# OPENAI_MODEL=gpt-6-astra
# ANTHROPIC_MODEL=

# Optional MCP transport settings for examples that support both transports.
# MCP_TRANSPORT=stdio
# MCP_HTTP_URL=http://127.0.0.1:3000/mcp
