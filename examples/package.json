{
  "name": "magento2-mcp-server-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.3.0",
  "scripts": {
    "check": "pnpm format:check && pnpm typecheck",
    "claude-agent": "tsx --env-file-if-exists=.env.local claude-agent-sdk/magento-agent.ts",
    "format:check": "prettier --check package.json tsconfig.json '**/*.{json,md,ts}'",
    "langchain-mcp": "tsx --env-file-if-exists=.env.local langchain-mcp-adapter/magento-agent.ts",
    "openai-agents": "tsx --env-file-if-exists=.env.local openai-agents-sdk/magento-agent.ts",
    "typecheck": "tsc --noEmit",
    "vercel-ai": "tsx --env-file-if-exists=.env.local vercel-ai-sdk/magento-agent.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.49",
    "@ai-sdk/openai": "^4.0.66",
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.13",
    "@openai/agents": "^0.18.0",
    "ai": "^7.0.99",
    "langchain": "^1.5.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
