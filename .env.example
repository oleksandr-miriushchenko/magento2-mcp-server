# Base Magento origin. Do not include a trailing /rest path.
MAGENTO_BASE_URL=
# Magento scope used directly in /rest/{scope}/V1/... for every request.
# default = Default Store View; all = global scope (All Store Views).
# You can also use another configured store view code. See docs/environment.md#store-scope.
MAGENTO_STORE_SCOPE=

# OAuth 1.0a credentials owned by the local MCP process.
MAGENTO_OAUTH_CONSUMER_KEY=
MAGENTO_OAUTH_CONSUMER_SECRET=
MAGENTO_OAUTH_ACCESS_TOKEN=
MAGENTO_OAUTH_ACCESS_TOKEN_SECRET=

# Per-request Magento deadline. GET may retry once; POST never retries.
MAGENTO_REQUEST_TIMEOUT_MS=10000
# Maximum Magento JSON response size in bytes. Defaults to 10 MiB and cannot exceed it.
MAGENTO_MAX_RESPONSE_BYTES=10485760
# Maximum page size allowed for paginated tools.
MCP_MAX_PAGE_SIZE=25
# PII-safe JSON Lines audit destination.
MCP_AUDIT_FILE=audit.jsonl

# Optional port for the loopback-only Streamable HTTP transport.
MCP_HTTP_PORT=3000
